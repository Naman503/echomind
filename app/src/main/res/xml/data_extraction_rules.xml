<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through backups or device transfer: transcripts and memory are private. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
